<%- include('../partials/header', { title: '举报处理' }) %>
<div class="admin-layout">
  <aside class="admin-nav">
    <a href="/admin">📊 概览</a>
    <a href="/admin/users">👥 用户管理</a>
    <a href="/admin/audit">📝 内容审核</a>
    <a class="active" href="/admin/reports">🚨 举报处理</a>
    <a href="/admin/boards">📋 板块与版主</a>
  </aside>
  <div class="admin-main">
    <h1>举报处理</h1>
    <ul class="audit-list">
      <% reports.forEach(r => { %>
        <li>
          <div class="muted small">
            #<%= r.id %> · 举报人：<%= r.reporter_name %> · 类型：<%= r.target_type %> · 目标 ID：<%= r.target_id %>
            <span class="tag <%= r.status === 'handled' ? 'ok' : 'warn' %>"><%= r.status === 'handled' ? '已处理' : '待处理' %></span>
          </div>
          <div class="audit-content">
            原因：<%= r.reason || '（未填写）' %>
            <% if (r.target) { %>
              <br>内容：<%= r.target.t || r.target.c %>
            <% } else { %>
              <br><span class="muted">（内容已被删除）</span>
            <% } %>
          </div>
          <% if (r.status === 'pending') { %>
            <form action="/admin/reports/<%= r.id %>/handle" method="post" class="inline">
              <button class="btn-mini primary">标记已处理</button>
            </form>
          <% } %>
        </li>
      <% }) %>
      <% if (reports.length === 0) { %><li class="empty">暂无举报</li><% } %>
    </ul>
  </div>
</div>
<%- include('../partials/footer') %>